{
  "manifest_version": 3,
  "name": "Cyber Threat Monitor",
  "version": "1.0",
  "description": "Real-time URL threat detection",
  "permissions": [
    "tabs",
    "webNavigation",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:18000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
